.DS_Store
.build/
xcuserdata/
*.xcuserstate
DerivedData/

# Extension signing key. The *public* half lives in extension/manifest.json and is what
# pins the extension ID, so the ID stays reproducible without this file. The private half
# is only needed to pack a .crx and must never be committed.
#
# Kept OUT of extension/ deliberately. Chrome warns about a .pem inside a loaded unpacked
# extension — "You probably don't want to do that" — and it is right: anything that packs or
# zips that directory ships the private key with it, and whoever has it can sign updates
# Chrome accepts as ours. Being gitignored protects the repo, not the folder.
keys/
extension/keys/
node_modules/
extension/dist/
