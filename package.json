{
  "name": "openposse-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "build:store": "node tools/build.mjs --store",
    "build:e2e": "node tools/build.mjs --e2e",
    "test:e2e": "npm run build:e2e && playwright test",
    "package": "npm run build:store && cd dist && zip -qr ../openposse-$npm_package_version.zip .",
    "lint": "eslint src tools test",
    "test": "eslint src tools test && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0"
  }
}
