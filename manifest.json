{
  "manifest_version": 3,
  "name": "OpenPosse",
  "version": "0.1.0",
  "description": "Lets OpenPosse talk to AI assistants living in web apps.",
  "key": "",
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.leanix.net/*"
  ],
  "action": {
    "default_title": "OpenPosse"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.leanix.net/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
