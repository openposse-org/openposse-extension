{
  "manifest_version": 3,
  "name": "OpenPosse",
  "version": "0.2.0",
  "description": "Talk to the AI assistants you already use. It listens, works out who you meant, and asks them.",
  "key": "",
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "OpenPosse",
    "default_popup": "popup.html"
  },
  "options_page": "setup.html",
  "commands": {
    "summon": {
      "suggested_key": { "default": "Ctrl+Shift+5" },
      "description": "Talk to an assistant",
      "global": true
    }
  }
}
