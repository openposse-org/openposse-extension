.DS_Store
node_modules/

# Build output: the extension Chrome loads, written by `npm run build`, and the store zip
# `npm run package` makes from it.
dist/
openposse-*.zip

# The browser tests' own build (`npm run build:e2e`) and what Playwright writes about a run.
dist-e2e/
test-results/
playwright-report/

# Extension signing key. The *public* half lives in src/manifest.json and is what pins the
# extension ID, so the ID stays reproducible without this file. The private half is only
# needed to pack a .crx and must never be committed.
#
# Kept out of dist/ deliberately. Chrome warns about a .pem inside a loaded unpacked
# extension – "You probably don't want to do that" – and it is right: anything that packs or
# zips that directory ships the private key with it, and whoever has it can sign updates
# Chrome accepts as ours. Being gitignored protects the repo, not the folder.
keys/

# Throwaway copies of an extension page, with its CSS and bundle inlined, for previewing it in
# the Claude app's browser pane. Never committed, and ignored so a preview does not show up as
# ~1,900 changed lines while it exists.
preview-*-tmp.html
